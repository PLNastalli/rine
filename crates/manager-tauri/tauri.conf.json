{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rine Manager",
  "version": "0.2.0-alpha.3",
  "identifier": "dev.rine.manager",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rine Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["binaries/rine"],
    "category": "System",
    "shortDescription": "Windows runs further.",
    "longDescription": "Rine Manager: library, capsules, pre-flight checks, run and diagnostics for the Rine Windows compatibility runtime."
  }
}
